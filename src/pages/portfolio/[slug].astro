---
import Layout from '../../layouts/Layout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio', ({ data }) => !data.draft);
  return projects.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, banner } = post.data;
---

<Layout
  title={`${title} | Getup Portfolio`}
  description={description}
  image={banner}
  type="article"
>
  <div class="pt-16 bg-neutral-950 min-h-screen">
    <CaseStudy post={post}>
      <Content />
    </CaseStudy>
  </div>
</Layout>
