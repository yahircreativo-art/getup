---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/hero.astro'
import ValueProposition from '../components/ValueProposition.astro'
import FeatureSection from '../components/FeatureSection.astro'
import Reviews from '../components/Reviews.astro'
import Pricing from '../components/Pricing.astro'
import ContactForm from '../components/ContactForm.astro'
import Logo from '../assets/getup.svg'
import Mockup from '../assets/mockup-laptop.webp'
import SEOPPC from '../assets/seo-ppc-google.webp'
import stats from '../assets/stats.webp'
---

<Layout
	title="GetUp - Home"
	description="Take your business to the next level with GetUp. We build professional websites for fitness and wellness businesses."
	image="/banner.webp"
	type="business"
>
	<Hero/>

	<ValueProposition />

	<Pricing />

	<Reviews />

	<section id="contact" class="py-20 px-4 md:px-8">
		<div class="max-w-2xl mx-auto">
			<img class="h-24 mx-auto mb-8" src={Logo.src} alt="">
			<h2 class="text-4xl sm:text-5xl font-black text-neutral-50 text-center mb-4">GET IN TOUCH</h2>
			<p class="text-neutral-200 text-lg text-center mb-10">Fill out the form below and we'll get back to you shortly.</p>
			<ContactForm />
		</div>
	</section>
</Layout>