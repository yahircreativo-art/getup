---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/hero.astro'
import FeatureSection from '../components/FeatureSection.astro'
import FloatingIcon from '../components/FloatingIcon.astro'
import Faq from '../components/sections/faq.astro'
import ContactForm from '../components/ContactForm.astro'
import adsIcon from '../assets/ads.webp'
import mailIcon from '../assets/mail.webp'
import callsIcon from '../assets/calls.webp'
import messageIcon from '../assets/message.webp'
---

<Layout
	title="GetUp - Tu negocio online"
	description="Lleva tu negocio al siguiente nivel con GetUp. Creamos presencia digital para empresas de fitness y bienestar."
	image="/og-home.png"
	type="business"
>
	<Hero>
		<FloatingIcon src={adsIcon.src} position="left" top="25%" rotation="-12deg" opacity={0.08} />
		<FloatingIcon src={callsIcon.src} position="right" top="45%" rotation="8deg" opacity={0.08} />
	</Hero>

	<FeatureSection
		title="LEVEL UP"
		description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
		imagePosition="right"
		titleIcon={adsIcon.src}
		buttonLabel="Learn more"
		buttonHref="#services"
	>
		<FloatingIcon src={mailIcon.src} position="left" top="30%" rotation="-5deg" opacity={0.08} />
	</FeatureSection>

	<FeatureSection
		title="SET UP ONLINE"
		description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
		imagePosition="left"
		titleIcon={mailIcon.src}
	>
		<FloatingIcon src={messageIcon.src} position="right" top="35%" rotation="10deg" opacity={0.08} />
	</FeatureSection>

	<Faq/>

	<section id="contact" class="py-20 px-4 md:px-8">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-4xl sm:text-5xl font-black text-neutral-50 text-center mb-4">Get in Touch</h2>
			<p class="text-neutral-200 text-lg text-center mb-10">Ready to take your business to the next level? Fill out the form below and we'll get back to you shortly.</p>
			<ContactForm />
		</div>
	</section>
</Layout>