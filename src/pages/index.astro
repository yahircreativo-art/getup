---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/hero.astro'
import ValueProposition from '../components/ValueProposition.astro'
import FeatureSection from '../components/FeatureSection.astro'
import ContactForm from '../components/ContactForm.astro'
import adsIcon from '../assets/ads.webp'
import mailIcon from '../assets/mail.webp'
import Logo from '../assets/getup.svg'
---

<Layout
	title="GetUp - Home"
	description="Take your business to the next level with GetUp. We build professional websites for fitness and wellness businesses."
	image="/og-home.png"
	type="business"
>
	<Hero/>

	<ValueProposition />

	<FeatureSection
		title="SET UP"
		description="Every business needs a great website — that's your Set Up. Beautiful design, great first impression."
		imagePosition="right"
		buttonLabel="Learn more"
		buttonHref="#services"
	>
	</FeatureSection>

	<FeatureSection
		title="LEVEL UP"
		description="Then we Level Up — helping your business show up locally, so real customers find you, call you, and choose you."
		imagePosition="left"
	>
	</FeatureSection>

	<section id="contact" class="py-20 px-4 md:px-8">
		<div class="max-w-2xl mx-auto">
			<img class="h-24 mx-auto mb-8" src={Logo.src} alt="">
			<h2 class="text-4xl sm:text-5xl font-black text-neutral-50 text-center mb-4">Get in Touch</h2>
			<p class="text-neutral-200 text-lg text-center mb-10">Ready to take your business to the next level? Fill out the form below and we'll get back to you shortly.</p>
			<ContactForm />
		</div>
	</section>
</Layout>