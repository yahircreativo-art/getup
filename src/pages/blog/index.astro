---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Getup - Blog"
  description="Tips and insights on web design, local SEO, and growing your business online."
  image="/banner.webp"
>
  <section class="py-24 px-4 md:px-8 bg-neutral-950 min-h-screen">
    <div class="max-w-7xl mx-auto w-full">
      <!-- Section Header (same style as Portfolio/Services) -->
      <div class="text-center mb-16">
        <span class="text-brand-400 font-semibold text-sm uppercase tracking-wider">Insights</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-neutral-50 mt-4">
          BLOG
        </h1>
        <p class="text-neutral-300 text-lg mt-4 max-w-2xl mx-auto">
          Tips and insights on web design, local SEO, and growing your business online.
        </p>
      </div>

      {posts.length === 0 ? (
        <p class="text-center text-neutral-400 text-lg">No articles yet. Check back soon!</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
