---
interface Props {
  images: string[];
  speed?: number; // Tiempo en segundos por vuelta
  direction?: 'left' | 'right'; // Prop opcional para controlar la dirección
}

const { images = [], speed = 20, direction = 'left' } = Astro.props as Props;

const duplicatedImages = [...images, ...images];

// Determinamos la clase de animación según la prop `direction`
const animationClass = direction === 'left' 
  ? 'animate-[infinite-scroll-left_var(--speed)_linear_infinite]' 
  : 'animate-[infinite-scroll-right_var(--speed)_linear_infinite]';
---

<div class="marquee relative w-full overflow-hidden rounded-xl select-none">
  <div 
    class={`marquee-track flex w-max ${animationClass}`}
    style={`--speed: ${speed}s;`}
  >
    {duplicatedImages.map((src, i) => (
      <div 
        class="shrink-0 mr-3 overflow-hidden rounded-xl bg-neutral-800/50 shadow-md"
        aria-hidden={i >= images.length ? 'true' : undefined}
      >
        <img 
          src={src} 
          alt={i < images.length ? `Slide ${(i % images.length) + 1}` : ''} 
          class="h-48 w-auto md:h-72 object-cover pointer-events-none" 
          loading="eager"
          decoding="async"
          draggable="false"
        />
      </div>
    ))}
  </div>
</div>

<style>
  /*
   * Fixes for iOS Safari / iPadOS:
   * 1. isolation + z-index force the container into its own stacking context so
   *    overflow:hidden + border-radius actually clips the animated child
   *    (WebKit bug: moving children escape rounded overflow containers).
   * 2. will-change + backface-visibility promote the track to a GPU layer,
   *    preventing repaint stutter on wide (~3000px) tracks.
   */
  .marquee {
    isolation: isolate;
    z-index: 0;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }

  .marquee-track {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none !important;
    }
  }
</style>

<script>
  /*
   * "A veces la animación no arranca" — causas y arreglo:
   *
   * 1. bfcache: al volver con atrás/adelante, Safari/Chrome restauran la página
   *    y la animación CSS puede quedar congelada. → hard restart en pageshow.
   * 2. WebKit a veces congela la capa compuesta (will-change) sin actualizarla,
   *    aunque getAnimations() diga "running". → watchdog que detecta transform
   *    idéntico entre muestras y reinicia.
   * 3. Al cambiar de pestaña/volver, la animación puede quedar en paused.
   *    → getAnimations().play() al volver la visibilidad.
   *
   * El reinicio es visualmente invisible porque el track duplica el contenido:
   * translateX(-50%) se ve igual que translateX(0).
   */

  const tracks = () => Array.from(document.querySelectorAll<HTMLElement>('.marquee-track'));

  function hardRestart(el: HTMLElement) {
    el.style.animation = 'none';
    void el.offsetWidth; // fuerza reflow para que el navegador descarte la animación
    el.style.animation = '';
  }

  function resumeAll() {
    tracks().forEach((el) => {
      if (typeof el.getAnimations !== 'function') return;
      el.getAnimations().forEach((a) => {
        if (a.playState === 'paused' || a.playState === 'idle') a.play();
      });
    });
  }

  // 1. Vuelta desde bfcache (atrás/adelante en iOS y Safari de escritorio)
  window.addEventListener('pageshow', (e) => {
    if ((e as PageTransitionEvent).persisted) {
      tracks().forEach(hardRestart);
    }
  });

  // 2. Volver a la pestaña / app
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) requestAnimationFrame(resumeAll);
  });

  // 3. Watchdog: detecta capas congeladas ("running" pero sin moverse)
  const lastSample = new WeakMap<HTMLElement, string | null>();
  const restarts = new WeakMap<HTMLElement, number>();

  function watchdog() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    tracks().forEach((el) => {
      if (typeof el.getAnimations !== 'function') return;
      const running = el.getAnimations().some((a) => a.playState === 'running');
      if (!running) {
        lastSample.set(el, null);
        return;
      }

      const t = getComputedStyle(el).transform;
      const prev = lastSample.get(el) ?? null;
      lastSample.set(el, t);
      if (!prev || prev !== t) return;

      const count = restarts.get(el) ?? 0;
      if (count >= 5) return; // evita reiniciar en bucle si algo lo congela de verdad
      restarts.set(el, count + 1);
      hardRestart(el);
      lastSample.set(el, null);
    });
  }

  // Muestras separadas ~2s: la animación siempre cambia de transform entre muestras
  setInterval(watchdog, 2000);
</script>
