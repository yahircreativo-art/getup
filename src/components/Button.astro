---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    border-radius: 9999px;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-standard),
      color 0.25s var(--ease-standard),
      border-color 0.25s var(--ease-standard),
      transform 0.2s var(--ease-standard),
      box-shadow 0.25s var(--ease-standard);
    white-space: nowrap;
    user-select: none;
  }

  .btn:active {
    transform: scale(0.97);
  }

  /* Sizes */
  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .btn-md {
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
  }

  .btn-lg {
    padding: 1rem 2.25rem;
    font-size: 1.125rem;
  }

  /* Primary */
  .btn-primary {
    background-color: var(--color-brand-600);
    color: white;
    box-shadow: 0 4px 14px rgb(99 60 200 / 0.35);
  }

  .btn-primary:hover {
    background-color: var(--color-brand-600);
    box-shadow: 0 6px 20px rgb(99 60 200 / 0.45);
    transform: translateY(-1px);
  }

  /* Secondary */
  .btn-secondary {
    background-color: var(--color-neutral-800);
    color: var(--color-neutral-50);
  }

  .btn-secondary:hover {
    background-color: var(--color-neutral-700);
    transform: translateY(-1px);
  }

  /* Outline */
  .btn-outline {
    background-color: transparent;
    color: var(--color-neutral-50);
    border: 2px solid rgba(255, 255, 255, 0.25);
  }

  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.05);
    transform: translateY(-1px);
  }

  /* Ghost */
  .btn-ghost {
    background-color: transparent;
    color: var(--color-neutral-200);
  }

  .btn-ghost:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-neutral-50);
  }
</style>

<Tag
  href={href}
  class:list={['btn', `btn-${variant}`, `btn-${size}`, className]}
  {...rest}
>
  <slot />
</Tag>
