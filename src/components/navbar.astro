---
interface Props {
  logo?: string;
  logoAlt?: string;
}

const { logo, logoAlt = "Logo" } = Astro.props;
---

<style>
  .nav-link {
    position: relative;
    display: inline-block;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-neutral-50);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .mobile-link {
    display: block;
    position: relative;
    padding-bottom: 2px;
  }

  nav {
    transition: transform 0.3s ease-in-out;
    background: rgba(13, 13, 13, 0.5);
    backdrop-filter: blur(10px);
  }

  nav.hidden-nav {
    transform: translateY(-100%);
  }
</style>

<nav id="navbar" class="fixed top-0 z-50 w-full">
  <div class="flex justify-center px-4 md:px-8 py-4">
    <div class="max-w-7xl w-full flex md:grid md:grid-cols-3 items-center justify-between md:justify-start gap-4">
      <!-- Logo -->
      <div class="flex-shrink-0">
        {logo ? (
          <img src={logo} alt={logoAlt} class="h-8 sm:h-12 md:h-14 w-auto" />
        ) : (
          <div class="text-xl font-black text-brand-500">LOGO</div>
        )}
      </div>

      <!-- Desktop Links -->
      <div class="hidden md:flex justify-center gap-8">
        <a href="#" class="nav-link text-neutral-50 font-semibold">HOME</a>
        <a href="#" class="nav-link text-neutral-50 font-semibold">SERVICES</a>
        <a href="#" class="nav-link text-neutral-50 font-semibold">ABOUT</a>
        <a href="#" class="nav-link text-neutral-50 font-semibold">CONTACT</a>
      </div>

      <!-- Empty Column -->
      <div class="hidden md:block"></div>

      <!-- Mobile Menu Toggle -->
      <button class="md:hidden flex-shrink-0" id="menu-toggle">
        <svg class="w-6 h-6 text-neutral-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden ">
    <div class="px-4 py-4">
      <div class="max-w-6xl w-full space-y-3 flex flex-col">
        <a href="#" class="mobile-link text-neutral-50 font-medium">Home</a>
        <a href="#" class="mobile-link text-neutral-50 font-medium">Services</a>
        <a href="#" class="mobile-link text-neutral-50 font-medium">About</a>
        <a href="#" class="mobile-link text-neutral-50 font-medium">Contact</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const navbar = document.getElementById('navbar');
  let lastScrollY = 0;
  let isScrollingDown = false;

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Cerrar menú al hacer click en un link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });

  // Hide navbar on scroll
  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    
    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      // Scrolling DOWN
      if (!isScrollingDown) {
        navbar?.classList.add('hidden-nav');
        isScrollingDown = true;
        mobileMenu?.classList.add('hidden');
      }
    } else {
      // Scrolling UP
      if (isScrollingDown) {
        navbar?.classList.remove('hidden-nav');
        isScrollingDown = false;
      }
    }
    
    lastScrollY = currentScrollY;
  });
</script>
