---
import icon from '../assets/getup-icon.svg';

interface Props {
  logo?: string;
  logoAlt?: string;
}

const { logo, logoAlt = "Logo" } = Astro.props;
---

<footer class="text-neutral-50 py-12 h-1/2 md:pt-48 md:pb-32" style="background: linear-gradient(180deg, var(--color-neutral-950), var(--color-brand-600) 80%)">
  <div class="px-4 md:px-8">
    <div class="max-w-7xl mx-auto w-full">
      <!-- Scroll to Top Section -->
      <div class="flex flex-col items-center justify-center mb-20">
        <button id="scroll-to-top" class="flex flex-col items-center gap-2 group cursor-pointer">
          <img src={icon.src} alt="GET UP" class="h-16 md:h-32 w-auto opacity-90 group-hover:opacity-100 transition-opacity" />
          <span class="text-2xl md:text-4xl font-bold text-neutral-100 group-hover:text-neutral-50 transition-colors">SCROLL UP</span>
        </button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
        <!-- Logo & Socials -->
        <div class="col-span-1">
          <div class="mb-6">
            {logo ? (
              <a href="/">
                <img src={logo} alt={logoAlt} class="h-10 md:h-14 w-auto" />
              </a>
            ) : (
              <div class="text-2xl font-black text-brand-500">LOGO</div>
            )}
          </div>
          <div class="flex gap-4">
            <a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors" aria-label="Facebook">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors" aria-label="X">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.6l-5.165-6.75-5.868 6.75h-3.308l7.737-8.835L2.076 2.25h6.75l4.676 6.189L17.142 2.25h1.102zm-1.06 17.02h1.828L7.671 3.912H5.756l11.428 15.358z"/>
              </svg>
            </a>
            <a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors" aria-label="Instagram">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37Z" fill="none" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
              </svg>
            </a>
            <a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors" aria-label="LinkedIn">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Services -->
        <div>
          <h3 class="text-lg font-bold mb-4">Services</h3>
          <ul class="space-y-2">
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Web Design</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Development</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Marketing</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Branding</a></li>
          </ul>
        </div>

        <!-- Company -->
        <div>
          <h3 class="text-lg font-bold mb-4">Company</h3>
          <ul class="space-y-2">
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">About Us</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Blog</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Careers</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Contact</a></li>
          </ul>
        </div>

        <!-- Legal -->
        <div>
          <h3 class="text-lg font-bold mb-4">Legal</h3>
          <ul class="space-y-2">
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Privacy</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Terms</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">Cookies</a></li>
            <li><a href="#" class="text-neutral-100 hover:text-neutral-50 transition-colors">License</a></li>
          </ul>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="border-t border-brand-700 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-neutral-200 text-sm">&copy; 2024 GET UP ONLINE. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

<script>
  const scrollToTopBtn = document.getElementById('scroll-to-top');

  scrollToTopBtn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>
