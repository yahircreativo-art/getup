---
import { siteConfig } from '../config/seo.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'business';
  schema?: Record<string, any>;
  robots?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  canonical = siteConfig.url,
  type = 'website',
  schema,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1',
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const fullImage = image.startsWith('http') ? image : `${siteConfig.url}${image}`;
const socials = Object.values(siteConfig.social || {}).filter(Boolean);
const { business, verification } = siteConfig;

const address = business?.address || {};
const cleanAddress = Object.fromEntries(
  Object.entries(address).filter(([, v]) => v && v !== '')
);
const hasAddress = Object.keys(cleanAddress).length > 0;
const hasGeo = business?.geo?.latitude && business?.geo?.longitude;

// Schema from site.config.business
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': business?.type || 'Organization',
  name: business?.name || siteConfig.title,
  ...(business?.legalName && { legalName: business.legalName }),
  description: business?.description || siteConfig.description,
  url: siteConfig.url,
  image: fullImage,
  logo: `${siteConfig.url}${siteConfig.logo || siteConfig.favicon}`,
  ...(hasAddress && {
    address: { '@type': 'PostalAddress', ...cleanAddress },
  }),
  ...(business?.phone && { telephone: business.phone }),
  ...(business?.email && { email: business.email }),
  ...(business?.priceRange && { priceRange: business.priceRange }),
  ...(business?.foundingDate && { foundingDate: business.foundingDate }),
  ...(business?.areaServed && { areaServed: business.areaServed }),
  ...(hasGeo && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: business.geo.latitude,
      longitude: business.geo.longitude,
    },
  }),
  ...(business?.openingHours?.length && {
    openingHoursSpecification: business.openingHours.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      ...h,
    })),
  }),
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: business?.contactType || 'customer service',
    ...(business?.phone && { telephone: business.phone }),
    ...(business?.email && { email: business.email }),
    availableLanguage: business?.languages || ['English'],
  },
  sameAs: socials,
};

const schemaData = schema || defaultSchema;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author || siteConfig.title} />
{siteConfig.keywords?.length > 0 && (
  <meta name="keywords" content={siteConfig.keywords.join(', ')} />
)}
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content={siteConfig.themeColor} />

{verification?.google && <meta name="google-site-verification" content={verification.google} />}
{verification?.bing && <meta name="msvalidate.01" content={verification.bing} />}

{hasGeo && (
  <>
    <meta name="geo.region" content={`${address.addressCountry || ''}-${address.addressRegion || ''}`} />
    {address.addressLocality && <meta name="geo.placename" content={address.addressLocality} />}
    <meta name="geo.position" content={`${business.geo.latitude};${business.geo.longitude}`} />
    <meta name="ICBM" content={`${business.geo.latitude}, ${business.geo.longitude}`} />
  </>
)}

<!-- Open Graph -->
<meta property="og:type" content={type === 'article' ? 'article' : siteConfig.ogType || 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImage} />
<meta property="og:image:width" content={siteConfig.ogImageWidth} />
<meta property="og:image:height" content={siteConfig.ogImageHeight} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.locale} />

<!-- Twitter -->
<meta name="twitter:card" content={siteConfig.twitterCard} />
{siteConfig.twitterSite && <meta name="twitter:site" content={`@${siteConfig.twitterSite}`} />}
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImage} />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />