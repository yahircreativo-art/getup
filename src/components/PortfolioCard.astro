---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'portfolio'>;
}

const { post } = Astro.props;
const { title, description, banner, pubDate, tags } = post.data;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const base = import.meta.env.BASE_URL; // ends with '/'
const bannerSrc = `${base}${banner.replace(/^\//, '')}`;
---

<a href={`/portfolio/${post.id}/`} class="portfolio-card group">
  <!-- Banner -->
  <div class="portfolio-image">
    <img
      src={bannerSrc}
      alt={title}
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute bottom-0 left-0 right-0 h-1/3 pointer-events-none bg-linear-to-t from-black/70 to-transparent" aria-hidden="true"></div>
    {tags.length > 0 && (
      <span class="absolute top-4 left-4 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-neutral-50 bg-brand-600/90 rounded-full">
        {tags[0]}
      </span>
    )}
  </div>

  <!-- Info -->
  <div class="portfolio-info">
    <time class="portfolio-date" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <h3 class="portfolio-title">{title}</h3>
    <p class="portfolio-description">{description}</p>
    <span class="portfolio-readmore">
      View case study
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </span>
  </div>
</a>

<style>
  .portfolio-card {
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.3s var(--ease-standard);
    text-decoration: none;
  }

  .portfolio-card:hover {
    transform: translateY(-6px);
    border-color: rgba(99, 60, 200, 0.4);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .portfolio-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-neutral-800);
  }

  .portfolio-image img {
    transition: transform 0.4s var(--ease-standard);
  }

  .portfolio-card:hover .portfolio-image img {
    transform: scale(1.05);
  }

  .portfolio-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .portfolio-date {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-400);
  }

  .portfolio-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-neutral-50);
  }

  .portfolio-description {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-neutral-400);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .portfolio-readmore {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-400);
  }
</style>
