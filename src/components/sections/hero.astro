---
import Button from '../Button.astro'
import Carousel from '../Carousel.astro'
// Public files (public/portfolio/) are served relative to the base path
const base = import.meta.env.BASE_URL; // ends with '/'
const hcproducts = `${base}portfolio/hcproducts.webp`;
const thekabobguy = `${base}portfolio/thekabobguy.webp`;
const portfolio3 = `${base}portfolio/portfolio3.webp`;

const slides = [hcproducts,thekabobguy, portfolio3]
const slides2 = [thekabobguy, portfolio3, hcproducts]
---

<section id="hero" class="relative flex justify-center overflow-hidden" style="background: radial-gradient(circle at center 5%, var(--color-brand-600), var(--color-brand-700) 20%, var(--color-neutral-950) 65%)">

  <!-- Floating icons layer -->
  <slot />

  <!-- Content -->
  <div class="relative z-10 w-full pt-42 pb-32 md:pt-64 flex justify-center text-center px-4 md:px-8">
    <div class="max-w-9xl mx-auto w-full">
    <div class="flex flex-col items-center gap-6 md:gap-8">
      <h1 class="hero-title text-4xl sm:text-6xl md:text-7xl font-black w-11/12 text-neutral-50 drop-shadow-2xl uppercase">
        WEB DESIGN IN BAKERSFIELD , CA
      </h1>
      <p class="hero-subtitle text-neutral-200 text-md md:text-xl max-w-2xl leading-relaxed opacity-0">
        Your Website with Traffic: Calls 24/7
      </p>
      <div class="hero-cta flex flex-col sm:flex-row gap-4 opacity-0">
        <Button variant="primary" size="md" href="#contact">
          CONTACT US
        </Button>
      </div>

      <div class="relative overflow-hidden max-w-7xl">
			<div class="flex flex-col gap-3">
				<Carousel images={slides2} speed={50} direction="left"/>
			</div>
			<div class="absolute inset-0 bg-linear-to-t from-primary via-50% via-transparent to-transparent"/>
		  </div>

    </div>
    </div>
  </div>
</section>

<style>

  .hero-title {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-in 0.5s var(--ease-standard) 0.1s forwards;
  }

  /* Subtitle entrance */
  .hero-subtitle {
    transform: translateY(15px);
    animation: hero-fade-in 0.7s var(--ease-standard) 0.2s forwards;
  }

  /* CTA entrance */
  .hero-cta {
    transform: translateY(15px);
    animation: hero-fade-in 0.7s var(--ease-standard) 0.3s forwards;
  }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-image-fade-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brand-image,
    .hero-title,
    .hero-subtitle,
    .hero-cta {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Image positions */
  .hero-img {
    position: absolute;
    z-index: 1;
    will-change: transform;
    object-fit: cover;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-img-1 {
    top: 12%;
    left: 5%;
    transform: translateY(0) rotate(-6deg);
    animation: img-enter 0.9s var(--ease-standard) 0.2s forwards;
  }

  .hero-img-2 {
    top: 18%;
    right: 4%;
    transform: translateY(0) rotate(4deg);
    animation: img-enter 0.9s var(--ease-standard) 0.4s forwards;
  }

  .hero-img-3 {
    bottom: 18%;
    left: 8%;
    transform: translateY(0) rotate(5deg);
    animation: img-enter 0.9s var(--ease-standard) 0.6s forwards;
  }

  .hero-img-4 {
    bottom: 12%;
    right: 6%;
    transform: translateY(0) rotate(-3deg);
    animation: img-enter 0.9s var(--ease-standard) 0.8s forwards;
  }

  @keyframes img-enter {
    from {
      opacity: 0;
      transform: translateY(30px) rotate(var(--rotate, 0deg));
    }
    to {
      opacity: 0.85;
      transform: translateY(0) rotate(var(--rotate, 0deg));
    }
  }
</style>
