---
import Button from '../Button.astro'
import Carousel from '../Carousel.astro'
import Logo from '../../assets/website-mockups.png'
// Public files (public/portfolio/) are served relative to the base path
const base = import.meta.env.BASE_URL; // ends with '/'
const haulerhacks = `${base}portfolio/hauler-hacks/hauler-hacks-mockup.webp`;
const wrapsandprints = `${base}portfolio/wraps-and-prints/wraps-and-prints-mockup.webp`;
const haulink = `${base}portfolio/haulink/haulink-mockup.webp`;

const slides = [haulerhacks,wrapsandprints, haulink]
const slides2 = [wrapsandprints, haulink, haulerhacks]
---

<section id="hero" class="relative flex justify-center overflow-hidden" style="background: radial-gradient(circle at center 5%, var(--color-brand-600), var(--color-brand-700) 20%, var(--color-neutral-950) 65%)">

  <!-- Floating icons layer -->
  <slot />

  <!-- Content -->
  <div class="relative z-10 w-full pt-32 pb-32 flex justify-center text-center px-4 md:px-8">
    <div class="max-w-9xl mx-auto w-full">
    <div class="flex flex-col items-center gap-6 md:gap-8">
      <img
        src={Logo.src}
        alt="GetUp"
        class="hero-brand-image w-full max-w-3xl h-40 sm:h-56 md:h-full object-contain"
        loading="eager"
        decoding="async"
      />
      <h1 class="hero-title text-4xl sm:text-6xl md:text-7xl font-black w-11/12 sm:max-w-3xl text-neutral-50 drop-shadow-2xl uppercase">
        WEB DESIGN IN KERN COUNTY
      </h1>
      <p class="hero-subtitle text-neutral-200 text-md md:text-xl max-w-2xl leading-relaxed opacity-0">
        YOU GET UP, WE SET UP. Google Ads that bring you local traffic and leads. Make your phone ring.
      </p>
      <div class="hero-cta flex flex-col sm:flex-row gap-4 opacity-0">
        <Button variant="primary" size="md" href="#contact">
          CONTACT
        </Button>
      </div>

      <div class="relative overflow-hidden pt-8 w-full">
			<div class="flex flex-col gap-3">
				<Carousel images={slides2} speed={50} direction="left"/>
			</div>
			<div class="absolute inset-0 bg-linear-to-t from-neutral-950 via-neutral-950/50 to-transparent"/>
		  </div>

    </div>
    </div>
  </div>
</section>

<style>

  .hero-brand-image {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    animation: hero-image-fade-in 0.8s var(--ease-standard) forwards;
  }

  .hero-title {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-in 0.5s var(--ease-standard) 0.1s forwards;
  }

  /* Subtitle entrance */
  .hero-subtitle {
    transform: translateY(15px);
    animation: hero-fade-in 0.7s var(--ease-standard) 0.2s forwards;
  }

  /* CTA entrance */
  .hero-cta {
    transform: translateY(15px);
    animation: hero-fade-in 0.7s var(--ease-standard) 0.3s forwards;
  }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-image-fade-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brand-image,
    .hero-title,
    .hero-subtitle,
    .hero-cta {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }


</style>
