---
---

<section class="bg-neutral-950">
  <div class="max-w-7xl mx-auto w-full px-4 md:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-brand-400 font-semibold text-sm uppercase tracking-wider">Why GetUp?</span>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-neutral-50 mt-4">
        YOUR BUSINESS DESERVES MORE
      </h2>
    </div>

    <!-- Two-Column Value Props -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
      <!-- Set Up -->
      <div class="value-card">
        <div class="value-number">01</div>
        <h3 class="value-title">SET UP</h3>
        <p class="value-description">
          Every business needs a great website — that's your <strong class="text-brand-400">Set Up</strong>. 
          Beautiful design, great first impression.
        </p>
        <div class="value-icon">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
      </div>

      <!-- Level Up -->
      <div class="value-card">
        <div class="value-number">02</div>
        <h3 class="value-title">LEVEL UP</h3>
        <p class="value-description">
          Then we <strong class="text-brand-400">Level Up</strong> — helping your business show up locally, 
          so real customers find you, call you, and choose you.
        </p>
        <div class="value-icon">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .value-card {
    position: relative;
    padding: 2rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.3s var(--ease-standard);
  }

  .value-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(99, 60, 200, 0.3);
    transform: translateY(-4px);
  }

  .value-number {
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
    color: rgba(99, 60, 200, 0.15);
    position: absolute;
    top: 1rem;
    right: 1.5rem;
  }

  .value-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-neutral-50);
    margin-bottom: 1rem;
  }

  .value-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-neutral-300);
  }

  .value-icon {
    margin-top: 1.5rem;
    color: var(--color-brand-400);
  }
</style>
